# Copy to .env (or export these in your shell) before running the app.

# --- Server ---
SERVER_PORT=8080

# --- Database: PostgreSQL (default profile) ---
DB_URL=jdbc:postgresql://localhost:5432/booking_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# --- Database: MySQL (use with SPRING_PROFILES_ACTIVE=mysql) ---
# DB_URL=jdbc:mysql://localhost:3306/booking_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=root
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_DIALECT=org.hibernate.dialect.MySQLDialect
# SPRING_PROFILES_ACTIVE=mysql

# --- JPA ---
DDL_AUTO=update
SHOW_SQL=false

# --- JWT ---
# Must be a Base64-encoded secret, >= 256 bits (32 bytes) for HS256.
# Generate one with: openssl rand -base64 32
JWT_SECRET=dGhpc19pc19hX3ZlcnlfbG9uZ19zZWNyZXRfa2V5X2Zvcl9qd3RfaG1hY19zaGEyNTZfc2lnbmluZw==
JWT_EXPIRATION_MS=86400000

# --- Logging ---
SECURITY_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
